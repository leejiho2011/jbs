# ═══════════════════════════════════════════════════════
#  .env - 환경 변수 설정 파일
#  이 파일을 복사하여 .env로 저장하고 값을 변경하세요
#  절대로 .env 파일을 Git에 커밋하지 마세요!
# ═══════════════════════════════════════════════════════

# ── 서버 ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── JWT 보안 (반드시 강력한 랜덤 문자열로 변경!) ────────
# 생성 예: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-very-strong-random-secret-key-change-this-now

# ── 어드민 계정 ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password!

# ── 데이터베이스 ─────────────────────────────────────────
DB_PATH=data/music.db

# ── 스트리밍 ─────────────────────────────────────────────
# Linux: sudo modprobe v4l2loopback 후 생성된 디바이스
VIRTUAL_CAMERA_DEVICE=/dev/video0
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=30

# 방송 중 배경 이미지 (없으면 검은 화면)
BACKGROUND_IMAGE=static/background.jpg

# yt-dlp 쿠키 파일 (유튜브 봇 차단 시 필요)
# YouTube에서 로그인 후 쿠키 내보내기 → cookies.txt
YTDLP_COOKIES=

# ── 방송 설정 ────────────────────────────────────────────
# 곡과 곡 사이 전환 시간 (초)
SONG_BUFFER_SECONDS=10
# 최대 신청 가능 곡 수
MAX_QUEUE_SIZE=50
