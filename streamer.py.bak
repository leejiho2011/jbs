"""
streamer.py
- Windows / macOS / Linux 지원
- mpv 기반 무중단 방송
- 곡 자동 재생
- 곡 안 잘림
- 곡 전환 1초 이하
- OBS 디스플레이 캡처 안정적
"""

import asyncio
import subprocess
import json
import os
import platform
from datetime import datetime
from typing import Optional


class StreamerManager:

    def __init__(self):

        self.is_running = False
        self.current_song = None
        self.mpv_process = None
        self.stop_event = asyncio.Event()

        self.is_windows = platform.system() == "Windows"

        # 운영체제별 IPC 경로
        if self.is_windows:
            self.ipc_path = r"\\.\pipe\mpvsocket"
        else:
            self.ipc_path = "/tmp/mpvsocket"

    # =========================================================
    # mpv 실행
    # =========================================================
    def start_mpv(self):

        # macOS/Linux 기존 소켓 제거
        if not self.is_windows:

            try:
                if os.path.exists(self.ipc_path):
                    os.remove(self.ipc_path)
            except:
                pass

        cmd = [
            "mpv",
            
            "--fs=yes",
            # 창 유지
            "--idle=yes",
            "--force-window=yes",
            "--keep-open=yes",

            # 자동재생
            "--pause=no",

            # 캐시 최적화
            "--cache=yes",
            "--cache-secs=20",

            "--cache-pause=no",

            "--prefetch-playlist=yes",

            "--demuxer-max-bytes=50M",
            "--demuxer-max-back-bytes=10M",

            # 창 위치
            "--geometry=1280x720+0+0",

            # IPC
            f"--input-ipc-server={self.ipc_path}",

            "--really-quiet"
        ]

        try:

            self.mpv_process = subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )

            return True

        except Exception as e:

            print("[Streamer] mpv 실행 실패:", e)
            return False

    # =========================================================
    # IPC 명령 전송
    # =========================================================
    async def send_command(self, command):

        try:

            # =========================
            # Windows
            # =========================
            if self.is_windows:

                with open(self.ipc_path, "r+", encoding="utf-8") as pipe:

                    pipe.write(json.dumps(command) + "\n")
                    pipe.flush()

                    response = pipe.readline()

                    if response:
                        return json.loads(response)

                    return None

            # =========================
            # macOS / Linux
            # =========================
            else:

                reader, writer = await asyncio.open_unix_connection(
                    self.ipc_path
                )

                writer.write(
                    (json.dumps(command) + "\n").encode()
                )

                await writer.drain()

                response = await reader.readline()

                writer.close()
                await writer.wait_closed()

                if response:
                    return json.loads(response.decode())

                return None

        except Exception as e:

            print("[Streamer] IPC 오류:", e)
            return None

    # =========================================================
    # 영상 로드
    # =========================================================
    async def load_video(self, video_url):

        # IPC 준비 대기
        for _ in range(50):

            if os.path.exists(self.ipc_path):
                break

            await asyncio.sleep(0.1)

        # 영상 교체
        await self.send_command({
            "command": [
                "loadfile",
                video_url,
                "replace"
            ]
        })

        # 자동재생 강제
        await self.send_command({
            "command": [
                "set_property",
                "pause",
                False
            ]
        })

    # =========================================================
    # 실제 재생 종료 대기
    # =========================================================
    async def wait_until_finished(self, end_time):

        last_time = -1
        same_count = 0

        while True:

            if self.stop_event.is_set():
                break

            if datetime.now() >= end_time:
                break

            if self.mpv_process.poll() is not None:
                raise RuntimeError("mpv 종료됨")

            result = await self.send_command({
                "command": [
                    "get_property",
                    "playback-time"
                ]
            })

            current_time = None

            if result:
                current_time = result.get("data")

            # 아직 로딩 중
            if current_time is None:

                await asyncio.sleep(0.1)
                continue

            # 재생시간 변화 감지
            if current_time == last_time:

                same_count += 1

            else:

                same_count = 0

            last_time = current_time

            # 약 1초 정지 상태면 종료
            if same_count >= 30:
                break

            await asyncio.sleep(0.03)

    # =========================================================
    # 방송 실행
    # =========================================================
    async def run_playlist(self, playlist, end_time, log_id):

        from database import update_broadcast_log

        self.is_running = True
        self.stop_event.clear()

        try:

            if not self.start_mpv():
                return

            # mpv 초기화 대기
            await asyncio.sleep(1)

            # 첫곡 preload
            preload_task = asyncio.create_task(
                asyncio.to_thread(
                    self.get_stream_url,
                    playlist[0]["youtube_url"]
                )
            )

            # =====================================================
            # 플레이리스트 실행
            # =====================================================

            for i, song in enumerate(playlist):

                if self.stop_event.is_set():
                    break

                if datetime.now() >= end_time:
                    break

                self.current_song = song

                # 미리 받아둔 URL 사용
                stream_url = await preload_task

                if not stream_url:
                    continue

                # 다음곡 preload
                if i + 1 < len(playlist):

                    next_song = playlist[i + 1]

                    preload_task = asyncio.create_task(
                        asyncio.to_thread(
                            self.get_stream_url,
                            next_song["youtube_url"]
                        )
                    )

                print(f"[Streamer] 재생 시작: {song['title']}")

                # 재생
                await self.load_video(stream_url)

                # 실제 끝날 때까지 대기
                await self.wait_until_finished(end_time)

        finally:

            self.stop_broadcast()

            await update_broadcast_log(
                log_id,
                "finished",
                datetime.now().strftime("%H:%M:%S")
            )

    # =========================================================
    # 방송 종료
    # =========================================================
    def stop_broadcast(self):

        self.stop_event.set()

        if self.mpv_process:

            self.mpv_process.terminate()

            try:
                self.mpv_process.wait(timeout=3)

            except subprocess.TimeoutExpired:
                self.mpv_process.kill()

        self.mpv_process = None
        self.current_song = None

        # macOS/Linux 소켓 삭제
        if not self.is_windows:

            try:
                if os.path.exists(self.ipc_path):
                    os.remove(self.ipc_path)
            except:
                pass

    # =========================================================
    # 유튜브 스트림 URL 추출
    # =========================================================
    def get_stream_url(self, youtube_url) -> Optional[str]:

        from config import YTDLP_COOKIES

        cmd = [
            "yt-dlp",

            "-f", "best",

            "--force-ipv4",

            "--get-url",

            "--no-playlist"
        ]

        if YTDLP_COOKIES:
            cmd += ["--cookies", YTDLP_COOKIES]

        cmd.append(youtube_url)

        try:

            result = subprocess.run(
                cmd,
                capture_output=True,
                text=True,
                timeout=60
            )

            if result.returncode == 0:

                return result.stdout.strip().split("\n")[0]

            print(result.stderr)

            return None

        except Exception as e:

            print("[Streamer] yt-dlp 오류:", e)

            return None


# =============================================================
# 싱글톤
# =============================================================

streamer = StreamerManager()